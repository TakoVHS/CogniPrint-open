cff-version: 1.2.0
message: "If you use CogniPrint in your research, please cite it as follows."
title: "CogniPrint: A mathematical framework for cognitive fingerprint analysis of text"
authors:
  - family-names: "Adriashkin"
    given-names: "Roman"
    orcid: "https://orcid.org/0009-0009-6337-1806"
    affiliation: "CogniPrint Research Initiative"
version: "0.1.2"
date-released: 2026-06-18
doi: "10.5281/zenodo.20756421"
url: "https://cogniprint.org"
repository-code: "https://github.com/TakoVHS/CogniPrint-open"
license: MIT
abstract: "CogniPrint is an open research framework for constructing compact, interpretable statistical fingerprints of text, studying their similarity and stability under controlled perturbations, and developing reproducible methods for future synthetic-language provenance research. Current scientific status remains descriptive_only; model-family attribution, human-AI intervention mapping, and provenance fusion are research targets rather than validated capabilities."
keywords:
  - "statistical text analysis"
  - "cognitive fingerprint"
  - "synthetic language"
  - "content provenance"
  - "human AI coauthoring"
  - "reproducible research"
  - "controlled perturbations"
  - "research software"
