FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md LICENSE CITATION.cff ./
COPY PUBLIC_RELEASE_MANIFEST.json DATA_CONSTITUTION.md DATA_LICENSE.md RESEARCH_FREEZE_001.md ./
COPY src ./src
COPY scripts ./scripts
COPY datasets ./datasets
COPY evidence ./evidence
COPY validation ./validation
COPY tests ./tests
COPY config ./config
COPY docs ./docs
COPY web ./web
COPY benchmarks ./benchmarks
COPY audit ./audit

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -e . \
    && python -m pip install --no-cache-dir build ruff

CMD ["sh", "-c", "python -m ruff check src tests scripts && python -m compileall -q src scripts tests && python -m unittest discover -s tests -p 'test_*.py' -v && python scripts/check_reviewer_web_contract.py && python scripts/check_public_benchmark_v11.py && python -m build"]
