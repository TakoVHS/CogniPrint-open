{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogniprint.org/schemas/cogniprint-evidence-v1.schema.json",
  "title": "CogniPrint Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact",
    "observations",
    "inferences",
    "attestations",
    "unknowns",
    "limitations",
    "reproducibility",
    "claim_policy"
  ],
  "properties": {
    "schema": { "const": "cogniprint-evidence-v1" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "mime_type": { "type": ["string", "null"], "maxLength": 128 },
        "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "acquisition_time": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observedEvidence" }
    },
    "inferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/inferredEvidence" }
    },
    "attestations": {
      "type": "array",
      "items": { "$ref": "#/$defs/attestedEvidence" }
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknownEvidence" }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "DESCRIPTIVE_ONLY",
          "INSUFFICIENT_EVIDENCE",
          "SHORT_TEXT",
          "OUT_OF_DISTRIBUTION",
          "UNSEEN_DOMAIN",
          "LOW_REFERENCE_COVERAGE",
          "UNCALIBRATED_SCORE",
          "NO_EXTERNAL_PROVENANCE",
          "CONFLICTING_PROVENANCE"
        ]
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code_commit": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$" },
        "dataset_hash": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
        "environment_hash": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
        "config_hash": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
        "feature_space_version": { "type": ["string", "null"], "maxLength": 128 },
        "reference_registry_version": { "type": ["string", "null"], "maxLength": 128 },
        "calibration_model_version": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "claim_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "unknown_required", "high_stakes_single_output_prohibited"],
      "properties": {
        "version": { "const": "cogniprint-claim-firewall-v1" },
        "unknown_required": { "const": true },
        "high_stakes_single_output_prohibited": { "const": true }
      }
    }
  },
  "$defs": {
    "baseEvidence": {
      "type": "object",
      "required": ["class", "code", "summary"],
      "properties": {
        "class": { "type": "string" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "summary": { "type": "string", "maxLength": 512 },
        "source_ref": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "observedEvidence": {
      "allOf": [
        { "$ref": "#/$defs/baseEvidence" },
        {
          "type": "object",
          "properties": { "class": { "const": "OBSERVED" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "inferredEvidence": {
      "allOf": [
        { "$ref": "#/$defs/baseEvidence" },
        {
          "type": "object",
          "required": ["confidence", "calibrated", "reference_space_status"],
          "properties": {
            "class": { "const": "INFERRED" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "calibrated": { "type": "boolean" },
            "reference_space_status": {
              "enum": ["IN_DISTRIBUTION", "OUT_OF_DISTRIBUTION", "UNKNOWN"]
            },
            "alternatives": {
              "type": "array",
              "items": { "type": "string", "maxLength": 128 }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "attestedEvidence": {
      "allOf": [
        { "$ref": "#/$defs/baseEvidence" },
        {
          "type": "object",
          "required": ["attestation_type", "validation_status"],
          "properties": {
            "class": { "const": "ATTESTED" },
            "attestation_type": {
              "enum": ["C2PA", "PROVIDER", "SIGNED_LOG", "REVISION_HISTORY", "OTHER"]
            },
            "validation_status": {
              "enum": ["VALIDATED", "PRESENT_UNVERIFIED", "INVALID", "CONFLICT", "UNSUPPORTED"]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "unknownEvidence": {
      "allOf": [
        { "$ref": "#/$defs/baseEvidence" },
        {
          "type": "object",
          "required": ["reason"],
          "properties": {
            "class": { "const": "UNKNOWN" },
            "reason": {
              "enum": [
                "INSUFFICIENT_EVIDENCE",
                "OUT_OF_DISTRIBUTION",
                "UNCALIBRATED",
                "NO_ATTESTATION",
                "CONFLICTING_EVIDENCE",
                "UNSUPPORTED_CLAIM"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
