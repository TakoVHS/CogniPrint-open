{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cogniprint:evidence-dossier:1",
  "title": "CogniPrint Evidence Dossier v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "status",
    "scientific_claim_evidence",
    "source",
    "software",
    "configuration",
    "artifacts",
    "claim_boundary"
  ],
  "properties": {
    "$schema": {"const": "urn:cogniprint:evidence-dossier:1"},
    "schema_version": {"const": 1},
    "status": {"const": "DEVELOPMENT_ONLY"},
    "scientific_claim_evidence": {"const": false},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_length", "included"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_length": {"type": "integer", "minimum": 0, "maximum": 104857600},
        "included": {"const": false}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit"],
      "properties": {
        "name": {"const": "cogniprint"},
        "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}[A-Za-z0-9.+-]*$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_length", "included", "basis"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_length": {"type": "integer", "minimum": 0, "maximum": 104857600},
        "included": {"const": false},
        "basis": {"enum": ["default-empty", "local-file-hash-only"]}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "byte_length", "media_type"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_length": {"type": "integer", "minimum": 0, "maximum": 104857600},
          "media_type": {"const": "application/octet-stream"}
        }
      }
    },
    "claim_boundary": {
      "type": "array",
      "prefixItems": [
        {"const": "descriptive-signals-only"},
        {"const": "no-authorship-or-identity-claim"},
        {"const": "no-legal-or-forensic-determination"},
        {"const": "no-deterministic-model-source-claim"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  }
}
