{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogniprint.org/schemas/challenge-001-revealed-label-v1.schema.json",
  "title": "CogniPrint Challenge 001 revealed label record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sample_id", "true_class", "known_to_reference"],
  "properties": {
    "schema": {"const": "cogniprint-challenge-001-revealed-label-v1"},
    "sample_id": {"type": "string", "minLength": 1},
    "true_class": {"type": "string", "minLength": 1},
    "known_to_reference": {"type": "boolean"},
    "label_source": {"type": "string", "minLength": 1},
    "label_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
